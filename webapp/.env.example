# Copy to .env and fill in. Never commit .env.

# fake = no AWS needed (build/test pages). aws = real tables + IoT Core.
BACKEND=fake

# Long random string. Signs the login cookie. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# --- Only needed when BACKEND=aws (values from the AWS side's Terraform outputs) ---
AWS_PROFILE=sbp-webapp
AWS_REGION=ap-southeast-1
IOT_DATA_ENDPOINT=
TABLE_PREFIX=sbp-
# Cognito login (terraform output cognito_user_pool_id / cognito_client_id; not secret)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# --- Telegram (Connect Telegram at sign-up). Token shared privately, never in git ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
